server {
    listen 8080;
    # https twin of the same site, for LAN rigs: a deck loaded over :8443
    # (after accepting the self-signed-cert warning once per device) is a
    # secure context, which unlocks Web MIDI, the tablet mic and wake lock.
    # The cert is generated on first boot by docker/gen-selfsigned-cert.sh.
    listen 8443 ssl;
    ssl_certificate /certs/hydra.crt;
    ssl_certificate_key /certs/hydra.key;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    # stock mime.types has no .webmanifest mapping (deck PWA manifest)
    location = /deck.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # the local CA certificate, downloadable so each device can install it
    # as a trusted authority instead of clicking through the warning —
    # Firefox/LibreWolf silently refuse Web MIDI on cert-override origins,
    # and Android wants CAs in its user credential store. Falls back to the
    # server cert itself when the pair was user-provided (no generated CA).
    location = /hydra.crt {
        root /certs;
        try_files /hydra-ca.crt /hydra.crt =404;
        default_type application/x-x509-ca-cert;
    }

    # Vite emits content-hashed filenames under /assets — cache forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # remote VJ deck relay — the WebSocket upgrade must pass through here AND
    # through any TLS proxy in front of this container. The upstream is
    # env-configurable (HYDRA_RELAY_HOST / HYDRA_RELAY_PORT, defaults hydra-relay:8081):
    # this file is an nginx envsubst template rendered at container start.
    # Resolved at request time (variable + docker DNS) so nginx still boots
    # when the relay service is not deployed.
    location /ws {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $vj_relay ${HYDRA_RELAY_HOST};
        proxy_pass http://$vj_relay:${HYDRA_RELAY_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # the relay pings every 25s; anything over that keeps sockets alive
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
